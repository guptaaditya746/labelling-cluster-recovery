# Paths on the machine where you run the scripts (Slurm node)
HARNESS_ROOT=./
CORPUS_ROOT=./
HARNESS_ARTIFACTS=./
# Empty = $HARNESS_ARTIFACTS/judge_cache.jsonl (as in the harness).
HARNESS_JUDGE_CACHE_FILE=

# Evidence documents (labelling evidence-docs). The harness packages read the model aliases
# (HARNESS_MODEL_AGENT, _HIGH, _SMALL, _EDC; defaults heavy-model / lite-model), LITELLM_BASE_URL, VLLM_API_KEY
# and the graph settings from this file too. HARNESS_PROFILE: empty = the harness's exhaustive profile,
# a name or path = that profile, none = no profile.
HARNESS_PROFILE=
# Empty = questions/questions.json; or a path, or a file name under $HARNESS_ROOT/datasets.
HARNESS_DOC_QUESTION_SET=
# Empty = evidence_docs/ in this repository; set it to an earlier build's folder to resume that build.
HARNESS_DOC_ROOT=
HARNESS_DOC_MAX_PAPERS=0                  # papers screened per question; 0 = every indexed paper
HARNESS_DOC_SCREEN_PASSAGES=10            # passages per paper the screening reader sees
HARNESS_DOC_EXTRACT_PASSAGES=12           # per relevant paper: cited + this many top-ranked passages; 0 = every passage
HARNESS_DOC_SCREENING_SAMPLE=5            # labelling screening-sample: not-relevant papers checked per question/interpretation
HARNESS_DOC_SCHEMA_PASSAGES=40            # passages schema inference sees per interpretation
HARNESS_DOC_CONCURRENCY=4                 # papers screened or extracted at the same time
HARNESS_DOC_CALL_TIMEOUT_S=600            # per model call while building (no run deadline applies)
TRIAGE_MODEL=                             # labelling triage: model alias; empty = HARNESS_MODEL_HIGH

# Must equal the harness .env so gold rows match benchmark runs (see README: "Snapshot")
CORPUS_SNAPSHOT_ID=
ONTOLOGY_VERSION=2024-06-14+cskg-2.0-subset
RETRIEVAL_INDEX_VERSION=bm25s-v1

# Argilla on Omen, reached through omen-tunnels ("argilla" service)
ARGILLA_API_URL=
ARGILLA_API_KEY=
ARGILLA_WORKSPACE=thesis

# The harness LiteLLM proxy (evidence documents); use the key the harness uses
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
VLLM_API_KEY=
